FROM node:20-slim

# Install system dependencies for Puppeteer, Cypress and video recording
RUN apt-get update && apt-get install -y \
    chromium \
    chromium-sandbox \
    ffmpeg \
    xvfb \
    dbus-x11 \
    libgtk2.0-0 \
    libgtk-3-0 \
    libgbm-dev \
    libnotify-dev \
    libnss3 \
    libxss1 \
    libasound2 \
    libxtst6 \
    xauth \
    xfonts-base \
    xfonts-100dpi \
    xfonts-75dpi \
    xfonts-scalable \
    fonts-liberation \
    fonts-noto-core \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set Puppeteer to use system Chromium
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Cypress environment variables
ENV CYPRESS_CACHE_FOLDER=/root/.cache/Cypress
ENV DISPLAY=:99
ENV TERM=xterm-256color

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.10.0 --activate

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY .npmrc ./

# Install all dependencies (including devDependencies)
RUN pnpm install --no-frozen-lockfile

# Install Cypress for test execution
RUN pnpm add cypress

# Install Cypress binary
RUN npx cypress install

# Copy configuration files
COPY tsconfig.json ./
COPY nodemon.json ./

# Copy source code
COPY src ./src

# Create necessary directories
RUN mkdir -p /app/uploads /app/temp/screenshots /app/temp/videos /app/temp/cypress-executions

# Set permissions for uploads and temp directories
RUN chmod 755 /app/uploads /app/temp

# Expose port
EXPOSE 3000

# Use nodemon for hot reload with robust Xvfb setup
CMD ["sh", "-c", "rm -f /run/dbus/pid /tmp/.X*lock && mkdir -p /run/user/0 && dbus-daemon --system --fork && dbus-daemon --session --fork --address=unix:path=/run/user/0/bus && Xvfb :99 -ac -screen 0 1920x1080x16 -nolisten tcp -dpi 96 +extension GLX +render -noreset & sleep 5 && export DISPLAY=:99 && export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus && export XDG_RUNTIME_DIR=/run/user/0 && export ELECTRON_DISABLE_SANDBOX=1 && export TERM=xterm-256color && pnpm run dev"]
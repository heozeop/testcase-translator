# Required API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional AI Provider Keys
OPENAI_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
PERPLEXITY_API_KEY=

# AI Configuration
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=4000
CLAUDE_TEMPERATURE=0.1
CLAUDE_TIMEOUT=30000

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/testcase_translator
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testcase_translator
DB_USER=postgres
DB_PASSWORD=password

# Application Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Environment
NODE_ENV=development

# WebSocket Configuration
WS_PORT=8001

# Puppeteer Configuration
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000

# Logging
LOG_LEVEL=info

# Session Configuration
SESSION_SECRET=your_session_secret_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# AI Generation Settings (optional)
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=8000
AI_TEMPERATURE=0.1

# Enable AI-powered Cypress code generation
ENABLE_AI_CYPRESS_GENERATION=true

# Code Quality Thresholds
MIN_CODE_QUALITY_SCORE=80
ENABLE_PAGE_OBJECTS_THRESHOLD=5
ENABLE_SUPPORT_UTILITIES_THRESHOLD=3
